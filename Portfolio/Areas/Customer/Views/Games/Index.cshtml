@using Portfolio.DTO.Models
@{
    ViewData["Title"] = "Gaming Collection";
}

@model List<Game>

<!-- Hero Section -->
<div class="game-hero-section text-center py-5">
    <div class="container">
        <h1 class="display-4 text-light mb-3">Play & Enjoy</h1>
        <p class="lead text-light mb-4">Check out these HTML5/CSS3 games I've implemented in Blazor. Have fun!</p>
    </div>
</div>

<div class="container py-4">
    <!-- Games Grid -->
    <div class="row" id="gamesContainer">
        @foreach (var game in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4 game-card">
                <div class="card h-100 shadow game-item">
                    <div class="game-img-container">
                        <img src="~/Images/games/@game.Preview" class="card-img-top game-image" alt="@game.GameName">
                        <div class="game-overlay">
                            <a asp-controller="Games" asp-action="@game.GameName.Replace(" ", "")" class="btn-play">
                                <i class="bi bi-play-circle-fill"></i>
                            </a>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <h4 class="card-title">@game.GameName</h4>
                        <a asp-controller="Games" asp-action="@game.GameName.Replace(" ", "")" class="btn btn-primary mt-2">
                            Play Now
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Empty State (in case you want to add filtering later) -->
    <div id="emptyState" class="row d-none">
        <div class="col-md-8 mx-auto text-center py-5">
            <i class="bi bi-controller display-1 text-muted"></i>
            <h3 class="mt-3">No games found</h3>
            <p class="text-muted">Check back later for more games!</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Fade in animation for game cards
            document.querySelectorAll('.game-card').forEach(function(card, index) {
                setTimeout(function() {
                    card.classList.add('visible');
                }, 100 * (index + 1));
            });
        });
    </script>

    <style>
        /* Game Hero Section */
        .game-hero-section {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            margin-top: -1.5rem;
            margin-bottom: 2rem;
            padding: 5rem 0;
            position: relative;
            overflow: hidden;
        }

            .game-hero-section::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
                z-index: 0;
            }

            .game-hero-section .container {
                position: relative;
                z-index: 1;
            }

        /* Game Cards */
        .game-card {
            opacity: 0;
            transform: translateY(20px);
            transition: transform 0.4s ease-out, opacity 0.6s ease-out;
        }

            .game-card.visible {
                opacity: 1;
                transform: translateY(0);
            }

        .game-item {
            border: none;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
            background-color: white;
        }

            .game-item:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15) !important;
            }

        .game-img-container {
            position: relative;
            overflow: hidden;
            height: 220px;
            background-color: #f8f9fa;
        }

        .game-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .game-item:hover .game-image {
            transform: scale(1.05);
        }

        /* Overlay with Play Button */
        .game-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.3);
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .game-item:hover .game-overlay {
            opacity: 1;
        }

        .btn-play {
            font-size: 4rem;
            color: white;
            opacity: 0.9;
            transition: all 0.3s ease;
        }

            .btn-play:hover {
                transform: scale(1.1);
                color: #ffffff;
                opacity: 1;
            }

        /* Card Body */
        .card-title {
            font-weight: 600;
            margin-bottom: 0.75rem;
            color: #333;
        }

        .card-body {
            padding: 1.5rem;
        }
    </style>
}