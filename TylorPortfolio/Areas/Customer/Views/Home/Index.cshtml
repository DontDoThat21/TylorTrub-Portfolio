@{
    ViewData["Title"] = "Home Page";
}

@model HomeViewModel

<div class="container">
    <div class="profile-card-container">
        <div class="profile-card shadow">
            <div class="profile-header">
                <div class="profile-intro">
                    <h1 class="profile-name">Tylor C. Trub</h1>
                    <div class="profile-title">
                        <span class="badge bg-primary"><i class="bi bi-code-slash"></i> Full-Stack Developer</span>
                        <span class="badge bg-secondary"><i class="bi bi-microsoft"></i> C#.NET Specialist</span>
                    </div>
                </div>
            </div>
            
            <div class="profile-body">
                <div class="profile-info">
                    <div class="info-item">
                        <i class="bi bi-laptop"></i>
                        <p>I am a full-stack developer, with a C#.NET back-end focus.</p>
                    </div>
                    <div class="info-item">
                        <i class="bi bi-folder-check"></i>
                        <p>Check out my <a asp-controller="Projects" asp-action="Index" class="profile-link">projects</a>, example labs, and examples of my work above.</p>
                    </div>
                    <div class="info-item">
                        <i class="bi bi-github"></i>
                        <p>I host the majority of my code on <a href="https://github.com/DontDoThat21" class="profile-link" target="_blank">GitHub</a>.</p>
                    </div>
                    <div class="info-item">
                        <i class="bi bi-controller"></i>
                        <p>Relax and play some <a asp-controller="Games" asp-action="Index" class="profile-link">HTML5/CSS3 games</a> I've created.</p>
                    </div>
                    <div class="info-item">
                        <i class="bi bi-calendar-check"></i>
                        <p>Available 8am to 5pm EST. <a href="mailto:tylortrub@gmail.com" class="profile-link">tylortrub@gmail.com</a></p>
                    </div>
                </div>
                
                <div class="profile-cta">
                    <a asp-controller="Home" asp-action="MVCDemo" class="btn btn-primary btn-lg">
                        <i class="bi bi-arrow-right-circle"></i> Check out my latest MVC .NET 8 project
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="section-divider">
    <div class="container">
        <hr>
    </div>
</div>

<div class="container-lg">
    @for (int i = 0; i < Model.PortfolioImageList.Count; i++)
    {
        if (i % 2 == 0 || i == 0)
        {
            // draw top row only and give image to top left col
            <div class="row">
                <div class="col-6">
                    <p style="float: left">
                        @Model.PortfolioImageList[i].DisplayText
                    </p>
                    <img src="~/Images/home/@Model.PortfolioImageList[i].FileName" class="pull-left border-0 rounded">

                </div>
                <div class="row"></div>
                <div class="col-6">
                    <br>
                    @if (i < Model.PortfolioImageList.Count - 1)
                    {
                        <img src="~/Images/home/lineTopLeftBottomRightWavy.png" class="img-fluid border-0 rounded">
                    }
                </div>
                <div class="col-6">
                </div>
            </div>
        }
        else // odd
        {
            <div class="row">
                <div class="col-3">
                </div>
                <div class="col-3">
                </div>
                <div class="col-6">
                    <p style="float: right">
                        @Model.PortfolioImageList[i].DisplayText
                    </p>
                    <img src="~/Images/home/@Model.PortfolioImageList[i].FileName" class="pull-right border-0 rounded">
                </div>
                <div class="row"></div>
                <div class="col-6"></div>
                <div class="col-6">
                    <br>
                    @if (i < Model.PortfolioImageList.Count - 1)
                    {
                        <img src="~/Images/home/lineTopRightBottomLeftWavy.png" class="img-fluid border-0 rounded">
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <link href="~/css/profile-card.css" rel="stylesheet" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                document.querySelector('.profile-card').classList.add('loaded');
            }, 100);
        });
    </script>
}